
{
  "info": {
    "name": "AI Review Manager",
    "description": "Local API requests for the AI Review Manager FastAPI project. The root endpoint is optional and may return 404 until implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks whether the API is running. Expected HTTP 200 with status healthy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Service is healthy', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "General",
      "item": [
        {
          "name": "GET API Info (optional)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Optional exercise: returns API name, version and welcome message. Will return 404 if you have not created GET / yet."
          },
          "response": []
        }
      ]
    }
  ]
}
